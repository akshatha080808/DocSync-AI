# Copy to backend/.env and fill in. Never commit backend/.env.
# Deterministic analysis works without a Gemini key.

GEMINI_API_KEY=AQ.your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Optional overrides
# DOCSYNC_DATA_DIR=
# MAX_UPLOAD_BYTES=41943040
# MAX_EXTRACT_BYTES=157286400
# MAX_FILES=4000
# MAX_COMPRESSION_RATIO=80
# GEMINI_MAX_INPUT_CHARS=14000
